REDIRECT_SSL=true
TOKEN=1234
SECRET=example-secret

DOZZLE_USER=admin
# Dozzle accepts only bcrypt hashes. Generate one (prompts for the password):
#   docker run -it --rm amir20/dozzle:v11 generate admin
# and copy the "password:" value. Double every "$" ("$2a$..." -> "$$2a$$..."),
# otherwise compose reads the rest as a variable and cuts the hash short.
DOZZLE_PASSWORD_HASH=$$2a$$11$$G9mv4Vq21RZ9eOTYjtDAVuDfsb163yWLfJrWWmBrMsxTSGeCJKXWS #password
